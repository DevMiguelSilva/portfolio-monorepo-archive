# Server-side secrets (used by /api routes locally via Vite + on Vercel)
# Never prefix these with VITE_ in production if you can avoid it.
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
GEMINI_API_KEY=your_gemini_api_key_here

# Model routing (optional — defaults below work with free-tier quotas)
# High-volume: parse JD, parse resume (≈500 RPD). Also the last tailor fallback.
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
# Skill definitions (?). High quota, and not the tailor models.
# GEMINI_MODEL_EXPLAIN_MODELS=gemini-3.1-flash-lite,gemini-3.1-flash-lite-preview
# Tailor resume + cover letter. Tried in order on 503/429, then GEMINI_MODEL_LITE.
# GEMINI_MODEL_TAILOR_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash

# Legacy single-model override (only used if GEMINI_MODEL_LITE is unset)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional fallbacks (legacy client env — prefer GEMINI_API_KEY above)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (optional — localStorage mode works without these)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
