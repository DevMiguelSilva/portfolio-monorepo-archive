# Server-side secrets (used by /api routes locally via Vite + on Vercel)
# Never prefix these with VITE_ in production if you can avoid it.
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
GEMINI_API_KEY=your_gemini_api_key_here

# Model routing (optional — defaults below work with free-tier quotas)
# High-volume: Accept/parse JD, parse resume, cover letter (≈500 RPD)
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
# Tailor CV: strongest first, then fallback when primary hits quota
GEMINI_MODEL_TAILOR=gemini-3.6-flash
GEMINI_MODEL_TAILOR_FALLBACK=gemini-3.5-flash

# Legacy single-model override (only used if GEMINI_MODEL_LITE is unset)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional fallbacks (legacy client env — prefer GEMINI_API_KEY above)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (optional — localStorage mode works without these)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
