# Server-side secrets (used by /api routes locally via Vite + on Vercel)
# Never prefix these with VITE_ in production if you can avoid it.
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Optional fallbacks (legacy client env — prefer GEMINI_API_KEY above)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-3.5-flash

# Supabase (optional — localStorage mode works without these)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
